{
  "manifest_version": 3,
  "name": "Job Application Autofill",
  "version": "1.1.0",
  "description": "Fill common job application questions from your saved profile with one click.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.jobvite.com/*",
    "https://*.workable.com/*",
    "https://*.bamboohr.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Application Autofill"
  },
  "options_page": "options.html"
}
